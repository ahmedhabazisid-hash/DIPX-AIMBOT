-- تخزين مربعات الـ ESP
local ESPBoxes = {}

local function RemoveESP(player)
    if ESPBoxes[player] then
        for _, obj in pairs(ESPBoxes[player]) do
            pcall(function() obj:Remove() end)
        end
        ESPBoxes[player] = nil
    end
end

Players.PlayerRemoving:Connect(RemoveESP)

-- التحقق مما إذا كان اللاعب داخل الماب (وليس تحت الأرض أو خارج الحدود)
local function IsPlayerInBounds(rootPart)
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        return true
    end
    
    local localPos = LocalPlayer.Character.HumanoidRootPart.Position
    local targetPos = rootPart.Position
    
    if math.abs(targetPos.Y - localPos.Y) > 80 then
        return false
    end
    
    return true
end

-- البحث عن أقرب هدف صالح داخل الماب وضمن نطاق الـ FOV
local function GetClosestTarget()
    local targetPart = nil
    local shortestDist = Config.FOVSize
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, v in ipairs(Players:GetPlayers()) do
        if v ~= LocalPlayer and v.Character then
            if not Config.TeamCheck or v.Team ~= LocalPlayer.Team then
                local humanoid = v.Character:FindFirstChildOfClass("Humanoid")
                local rootPart = v.Character:FindFirstChild("HumanoidRootPart") or v.Character:FindFirstChild("Torso")
                
                if humanoid and humanoid.Health > 0 and rootPart then
                    if IsPlayerInBounds(rootPart) then
                        local screenPos, onScreen = Camera:WorldToViewportPoint(rootPart.Position)
                        if onScreen then
                            local dist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                            if dist < shortestDist then
                                shortestDist = dist
                                targetPart = rootPart
                            end
                        end
                    end
                end
            end
        end
    end
    return targetPart
end

-- تفعيل الـ FPS Boost
local function ToggleFPSBoost(state)
    Config.FPSBoostEnabled = state
    pcall(function()
        if state then
            settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
            Lighting.GlobalShadows = false
            Lighting.FogEnd = 9e9
            for _, v in ipairs(Lighting:GetChildren()) do
                if v:IsA("PostEffect") or v:IsA("Sky") then
                    v.Enabled = false
                end
            end
            for _, v in ipairs(workspace:GetDescendants()) do
                if v:IsA("BasePart") then
                    v.Material = Enum.Material.SmoothPlastic
                    v.Reflectance = 0
                elseif v:IsA("Decal") or v:IsA("Texture") then
                    v.Transparency = 1
                end
            end
        else
            Lighting.GlobalShadows = true
            for _, v in ipairs(Lighting:GetChildren()) do
                if v:IsA("PostEffect") or v:IsA("Sky") then
                    v.Enabled = true
                end
            end
        end
    end)
end

-- التحقق من ضغط زر الماوس الأيمن أو شِفت
local function IsAiming()
    return UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) or UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
end

-- حلقة التشغيل الأساسية
RunService.RenderStepped:Connect(function()
    FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    FOVCircle.Radius = Config.FOVSize
    FOVCircle.Visible = Config.AimbotEnabled

    if Config.AimbotEnabled and IsAiming() then
        local target = GetClosestTarget()
        if target then
            local currentCFrame = Camera.CFrame
            local targetCFrame = CFrame.new(currentCFrame.Position, target.Position + Vector3.new(0, 0.5, 0))
            Camera.CFrame = currentCFrame:Lerp(targetCFrame, 0.25)
        end
    end

    -- رسم الـ ESP على اللاعبين
    for _, v in ipairs(Players:GetPlayers()) do
        if v ~= LocalPlayer then
            local rootPart = v.Character and (v.Character:FindFirstChild("HumanoidRootPart") or v.Character:FindFirstChild("Torso"))
            local isValid = v.Character and v.Character:FindFirstChild("Humanoid") and v.Character.Humanoid.Health > 0 and rootPart
            
            if Config.ESPEnabled and isValid and IsPlayerInBounds(rootPart) then
                if not ESPBoxes[v] then
                    local box = Drawing.new("Square")
                    box.Visible = false
                    box.Color = Color3.fromRGB(0, 255, 200)
                    box.Thickness = 1.5
                    box.Filled = false
                    ESPBoxes[v] = {Box = box}
                end
                
                local rootScreen, rootOnScreen = Camera:WorldToViewportPoint(rootPart.Position)
                
                if rootOnScreen then
                    local headScreen = Camera:WorldToViewportPoint(rootPart.Position + Vector3.new(0, 2, 0))
                    local legScreen = Camera:WorldToViewportPoint(rootPart.Position - Vector3.new(0, 2, 0))
                    local height = math.abs(headScreen.Y - legScreen.Y)
                    local width = height / 2
                    
                    local box = ESPBoxes[v].Box
                    box.Size = Vector2.new(width, height)
                    box.Position = Vector2.new(rootScreen.X - width / 2, headScreen.Y)
                    box.Visible = true
                else
                    if ESPBoxes[v] and ESPBoxes[v].Box then
                        ESPBoxes[v].Box.Visible = false
                    end
                end
            else
                RemoveESP(v)
            end
        end
    end
end)

