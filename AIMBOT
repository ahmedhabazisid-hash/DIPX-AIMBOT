local function CreateButton(name, defaultState, callback)
    local Btn = Instance.new("TextButton")
    Btn.Parent = ScrollingFrame
    Btn.BackgroundColor3 = Color3.fromRGB(22, 22, 32)
    Btn.Size = UDim2.new(1, 0, 0, 45)
    Btn.Font = Enum.Font.GothamMedium
    Btn.Text = name .. ": " .. (defaultState and "ON" or "OFF")
    Btn.TextColor3 = Color3.fromRGB(230, 230, 230) -- لون أبيض هادئ ومريح للعين
    Btn.TextSize = 13

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 8)
    Corner.Parent = Btn

    local Stroke = Instance.new("UIStroke")
    Stroke.Color = defaultState and Color3.fromRGB(0, 200, 140) or Color3.fromRGB(60, 60, 80)
    Stroke.Thickness = 1
    Stroke.Parent = Btn

    local state = defaultState
    Btn.MouseButton1Click:Connect(function()
        state = not state
        Btn.Text = name .. ": " .. (state and "ON" or "OFF")
        Stroke.Color = state and Color3.fromRGB(0, 200, 140) or Color3.fromRGB(60, 60, 80)
        callback(state)
    end)
end

